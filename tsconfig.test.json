{
  // Tests run in Node under Vitest: Node types allowed, DOM not (yet).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "lib": ["ES2023", "ESNext.Disposable"],
    "types": ["node"]
  },
  "include": ["test/unit/**/*.test.ts", "test/integration/**/*.ts"],
  // Need lib DOM: app and render's viewport (tsconfig.test-app.json).
  "exclude": ["test/unit/app/**/*.test.ts", "test/unit/ui/**/*.test.ts"]
}
