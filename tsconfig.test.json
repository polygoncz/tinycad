{
  // Tests run in Node under Vitest: Node types allowed, DOM not (yet).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "lib": ["ES2023", "ESNext.Disposable"],
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts", "tests/**/*.ts"],
  // Need lib DOM: IndexedDB types (tsconfig.test-idb.json), app and render's viewport
  // (tsconfig.test-app.json).
  "exclude": ["src/persistence/idb/**/*.test.ts", "src/app/**/*.test.ts", "src/ui/**/*.test.ts"]
}
