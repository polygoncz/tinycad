{
  // Everything in src/ that ships to the browser, including ring 3 (ui, render, app, adapters).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "ESNext.Disposable", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["src/**/*.test.ts"]
}
