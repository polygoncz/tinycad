{
  "kind": "ops.upcast",
  "description": "A batch upcasts a feature.setParams version 1 inside it",
  "source": "test/unit/ops/upcast.test.ts › upcastOperation › upcasts a batch recursively",
  "input": {
    "operation": {
      "type": "batch",
      "v": 1,
      "ops": [
        {
          "type": "feature.setParams",
          "v": 1,
          "featureId": "a",
          "params": {
            "size": 1
          }
        },
        {
          "type": "batch",
          "v": 1,
          "ops": [
            {
              "type": "feature.setParams",
              "v": 1,
              "featureId": "a",
              "params": {
                "size": 2
              }
            }
          ]
        }
      ]
    }
  },
  "expected": {
    "ok": {
      "operation": {
        "type": "batch",
        "v": 1,
        "ops": [
          {
            "type": "feature.setParams",
            "v": 2,
            "featureId": "a",
            "params": {
              "size": 1
            },
            "typeVersion": 1
          },
          {
            "type": "batch",
            "v": 1,
            "ops": [
              {
                "type": "feature.setParams",
                "v": 2,
                "featureId": "a",
                "params": {
                  "size": 2
                },
                "typeVersion": 1
              }
            ]
          }
        ]
      }
    }
  }
}
