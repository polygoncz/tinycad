{
  // Tests of the composition root (app) and of ui (which sees AppSession): Node under Vitest with fakes, but app's own code names
  // DOM types (HTMLElement of mountViewport) and imports render, whose viewport uses the DOM.
  // Kept apart so the other tests stay without DOM, like tsconfig.test-idb.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test-app.tsbuildinfo",
    "lib": ["ES2023", "ESNext.Disposable", "DOM"],
    "types": ["node"]
  },
  "include": ["src/app/**/*.test.ts", "src/ui/**/*.test.ts", "src/ui/**/*.vue"]
}
