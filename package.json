{
  "name": "tinycad",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "lint:deps": "depcruise src tests --config .dependency-cruiser.cjs --output-type err-long",
    "lint:vault": "node scripts/vault-lint.mjs",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "check": "npm run typecheck && npm run lint && npm run lint:deps && npm run lint:vault && npm run test"
  },
  "dependencies": {
    "gl-matrix": "^3.4.4",
    "replicad-opencascadejs": "1.1.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
