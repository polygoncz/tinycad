{
  "name": "tinycad",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . && prettier --check --cache --cache-strategy content .",
    "format": "prettier --write . && eslint --fix .",
    "lint:deps": "depcruise src test --config .dependency-cruiser.cjs --output-type err-long",
    "lint:vault": "node scripts/vault-lint.mjs",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "cases:record": "node scripts/cases-record.mjs",
    "test:e2e": "playwright test --project=chrome",
    "test:e2e:full": "playwright test",
    "check": "run-p --aggregate-output --continue-on-error typecheck lint lint:deps lint:vault test test:integration"
  },
  "dependencies": {
    "@salusoft89/planegcs": "1.3.0",
    "@tabler/icons-webfont": "^3.49.0",
    "gl-matrix": "^3.4.4",
    "opentype.js": "2.0.0",
    "replicad-opencascadejs": "1.1.0",
    "three": "~0.186.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "1.3.10",
    "@types/three": "~0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
